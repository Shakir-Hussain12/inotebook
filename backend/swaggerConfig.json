{
  "openapi": "3.0.0",
  "info": {
    "title": "iNoteBook API",
    "version": "1.0.0",
    "description": "API documentation for iNoteBook application"
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "id": {
            "type": "string",
            "description": "The auto-generated id of the user"
          },
          "name": {
            "type": "string",
            "description": "The name of the user"
          },
          "email": {
            "type": "string",
            "description": "The email of the user"
          },
          "password": {
            "type": "string",
            "description": "The password of the user"
          },
          "date": {
            "type": "string",
            "description": "The date the user was created"
          }
        },
        "example": {
          "id": "d5fE_asz",
          "name": "John Doe",
          "email": "johndoe@example.com",
          "password": "123456"
        }
      },
      "Note": {
        "type": "object",
        "required": ["tag", "title", "description"],
        "properties": {
          "id": {
            "type": "string",
            "description": "The auto-generated id of the Note"
          },
          "user": {
            "type": "string",
            "description": "The id of the user who created the note"
          },
          "tag": {
            "type": "string",
            "description": "The tag of the Note"
          },
          "title": {
            "type": "string",
            "description": "The title of the Note"
          },
          "description": {
            "type": "string",
            "description": "The description of the Note"
          },
          "date": {
            "type": "string",
            "description": "The date the Note was created"
          }
        },
        "example": {
          "id": "d5fE_asz",
          "user": "d5fE_asz312",
          "tag": "Personal",
          "title": "First Note",
          "description": "This is my very first Note"
        }
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token",
        "description": "JWT token for authorization"
      }
    }
  },
  "paths": {
    "/api/auth": {
      "get": {
        "summary": "Returns the list of all users",
        "tags": ["Auth"],
        "responses": {
          "200": {
            "description": "The list of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/createuser": {
      "post": {
        "summary": "Registers a new user",
        "tags": ["Auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties":{
                  "name": {
                    "type": "string",
                    "description": "The name of the user"
                  },
                  "email": {
                    "type": "string",
                    "description": "The email of the user"
                  },
                  "password": {
                    "type": "string",
                    "description": "The password of the user"
                  }
                },
                "required": ["name", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "response": "User registered successfully"
          },
          "400": {
            "description": "Invalid credentials"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login a user",
        "tags": ["Auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "The email of the user"
                  },
                  "password": {
                    "type": "string",
                    "description": "The password of the user"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in successfully",
            "headers": {
              "Set-Cookie": {
                "description": "set token & refreshToken cookie",
                "schema": {
                  "type": "string",
                  "example": "token=eyJsae1dsa.1e1esafd1dsd.131313dsad1 { httpOnly: true, domain: 'localhost', path: '/' }"
                }
              }
            },
            "content": {
              "application/json": {
                "accessToken": "string",
                "refreshToken": "string"
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/auth/getuser": {
      "post": {
        "summary": "Get Details Of Current User",
        "tags": ["Auth"],
        "description": "Get Details Of Current User using JWT token sent as cookie",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/auth/logout": {
      "get": {
        "summary": "Logs User out and deletes cookies",
        "tags": ["Auth"],
        "responses": {
          "200": {
            "headers": {
              "Set-Cookie": {
                "description": "delete token & refreshToken cookie",
                "schema": {
                  "type": "string",
                  "example": "token= '' { Max-Age=0, httpOnly, domain=localhost, path=/ }"
                }
              }
            },
            "description": "User logged out successfully"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "get": {
        "summary": "Refreshes the authToken",
        "tags": ["Auth"],
        "parameters": [
          {
            "name": "refreshToken",
            "in": "cookie",
            "required": true,
            "description": "refreshToken"
          }
        ],
        "responses": {
          "200": {
            "description": "authToken refreshed successfully",
            "headers": {
              "Set-Cookie": {
                "description": "set token cookie",
                "schema": {
                  "type": "string",
                  "example": "token=eyJsae1dsa.1e1esafd1dsd.131313dsad1 { httpOnly: true, domain: 'localhost', path: '/' }"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/notes": {
      "get": {
        "summary": "Returns the list of all notes for current user",
        "tags": ["Notes"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The list of notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Note"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Create a new note",
        "tags": ["Notes"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string",
                    "description": "The tag of the Note"
                  },
                  "title": {
                    "type": "string",
                    "description": "The title of the Note"
                  },
                  "description": {
                    "type": "string",
                    "description": "The description of the Note"
                  }
                },
                "required": ["tag", "title", "description"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "msg": "Note created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/notes/{id}": {
      "delete": {
        "summary": "Deletes a note",
        "tags": ["Notes"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The id of the note to delete",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Note deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Note not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "summary": "Updates a note",
        "tags": ["Notes"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The id of the note to update",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Note updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Note not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  }
}
  